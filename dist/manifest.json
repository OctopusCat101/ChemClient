{
  "name": "ChemClient",
  "icon": "icon.png",
  "version": "1.7.47",
  "description": "Chem 客户端，支持模块管理与 NoirMusic、Magic 内容导入",
  "author": "Chem contributors",
  "website": "https://github.com/OctopusCat101/ChemClient",
  "entry": "chemclient.wasm",
  "wasi_version": 2,
  "api_level": 4,
